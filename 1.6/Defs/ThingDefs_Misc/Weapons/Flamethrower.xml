<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BaseHumanMakeableGun">
        <defName>CG_Flamethrower</defName>
        <label>flamethrower</label>
        <description>A napalm-projecting weapon that sprays a continuous arc of burning fuel. The longer you fire at a location, the wider the blaze spreads outward. Prolonged use superheats the operator.</description>
        <graphicData>
            <texPath>Things/Item/Equipment/WeaponRanged/IncendiaryLauncher</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <soundInteract>Interact_Shotgun</soundInteract>
        <recipeMaker>
            <researchPrerequisite>GunTurrets</researchPrerequisite>
            <skillRequirements>
                <Crafting>5</Crafting>
            </skillRequirements>
            <displayPriority>430</displayPriority>
        </recipeMaker>
        <statBases>
            <WorkToMake>30000</WorkToMake>
            <Mass>6</Mass>
            <AccuracyTouch>1</AccuracyTouch>
            <AccuracyShort>1</AccuracyShort>
            <AccuracyMedium>1</AccuracyMedium>
            <AccuracyLong>1</AccuracyLong>
            <RangedWeapon_Cooldown>0</RangedWeapon_Cooldown>
        </statBases>
        <costList>
            <Steel>80</Steel>
            <ComponentIndustrial>6</ComponentIndustrial>
        </costList>
        <verbs>
            <li>
                <verbClass>CrimsonGridFramework.Verb_ShootFlamethrower</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>CG_Bullet_Flamethrower</defaultProjectile>
                <warmupTime>1.5</warmupTime>
                <range>14.9</range>
                <burstShotCount>1</burstShotCount>
                <ticksBetweenBurstShots>3</ticksBetweenBurstShots>
                <soundCast>Shot_Shotgun</soundCast>
                <soundCastTail>GunTail_Light</soundCastTail>
                <muzzleFlashScale>12</muzzleFlashScale>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                    <canTargetPawns>true</canTargetPawns>
                    <canTargetBuildings>true</canTargetBuildings>
                </targetParams>
            </li>
        </verbs>
        <weaponTags>
            <li>IndustrialGun</li>
        </weaponTags>
        <tools>
            <li>
                <label>barrel</label>
                <capacities>
                    <li>Blunt</li>
                    <li>Poke</li>
                </capacities>
                <power>9</power>
                <cooldownTime>2</cooldownTime>
            </li>
        </tools>
        <comps>
            <li Class="CrimsonGridFramework.CompProperties_Flamethrower">
                <heatPerShot>0.00025</heatPerShot>
                <fireStartChance>0.1</fireStartChance>
                <napalmSpawnChance>0.5</napalmSpawnChance>
                <heatHediff>CG_FlamethrowerHeat</heatHediff>
                <filthDef>CG_Filth_Napalm</filthDef>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="BaseBullet">
        <defName>CG_Bullet_Flamethrower</defName>
        <label>napalm burst</label>
        <graphicData>
            <texPath>Things/Special/Fire/FireA</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>TransparentPostLight</shaderType>
            <drawSize>(0.4, 0.4)</drawSize>
        </graphicData>
        <thingClass>CrimsonGridFramework.Projectile_Flamethrower</thingClass>
        <projectile>
            <damageDef>Flame</damageDef>
            <damageAmountBase>8</damageAmountBase>
            <speed>28</speed>
            <arcHeightFactor>1.1</arcHeightFactor>
            <flyOverhead>true</flyOverhead>
        </projectile>
    </ThingDef>

    <ThingDef ParentName="BaseFilth">
        <defName>CG_Filth_Napalm</defName>
        <label>napalm puddle</label>
        <description>A puddle of flammable napalm.</description>
        <useHitPoints>true</useHitPoints>
        <tickerType>Normal</tickerType>
        <statBases>
            <Beauty>-10</Beauty>
            <Cleanliness>-15</Cleanliness>
            <MaxHitPoints>100</MaxHitPoints>
            <Flammability>2</Flammability>
        </statBases>
        <graphicData>
            <texPath>Things/Filth/LiquidFuel</texPath>
        </graphicData>
        <filth>
            <ignoreFilthMultiplierStat>true</ignoreFilthMultiplierStat>
            <disappearsInDays>35~40</disappearsInDays>
            <rainWashes>true</rainWashes>
            <cleaningWorkToReduceThickness>70</cleaningWorkToReduceThickness>
            <canFilthAttach>true</canFilthAttach>
            <maxThickness>1</maxThickness>
            <cleaningSound>Interact_CleanFilth_Fluid</cleaningSound>
        </filth>
    </ThingDef>

    <HediffDef>
        <defName>CG_FlamethrowerHeat</defName>
        <label>overheating</label>
        <description>The operator is overheating from prolonged flamethrower use. Heat dissipates slowly when not firing.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>true</isBad>
        <initialSeverity>0</initialSeverity>
        <maxSeverity>1</maxSeverity>
        <comps>
            <li Class="CrimsonGridFramework.HediffCompProperties_FlamethrowerHeat">
                <heatDecayPerTick>0.00008</heatDecayPerTick>
                <decayCooldownTicks>120</decayCooldownTicks>
                <randomBurnDamage>3</randomBurnDamage>
                <randomBurnIntervalTicks>200</randomBurnIntervalTicks>
                <randomBurnChance>0.3</randomBurnChance>
                <severeBurnDamage>8</severeBurnDamage>
                <severeBurnIntervalTicks>80</severeBurnIntervalTicks>
                <severeBurnChance>0.4</severeBurnChance>
                <meltdownExplosionRadius>3.9</meltdownExplosionRadius>
                <meltdownFireRadius>5</meltdownFireRadius>
                <meltdownNapalmRadius>4</meltdownNapalmRadius>
                <burnDamageDef>CG_Burn</burnDamageDef>
                <meltdownExplosionDamageDef>Bomb</meltdownExplosionDamageDef>
                <meltdownFireDamageDef>Flame</meltdownFireDamageDef>
                <meltdownKillDamage>99999</meltdownKillDamage>
                <meltdownKillArmorPenetration>999</meltdownKillArmorPenetration>
                <meltdownWarningIntervalTicks>240</meltdownWarningIntervalTicks>
                <heatstrokeMessageIntervalTicks>600</heatstrokeMessageIntervalTicks>
                <pressurizedThreshold>0.66</pressurizedThreshold>
                <meltdownThreshold>0.85</meltdownThreshold>
                <pressurizedGlowSize>0.8</pressurizedGlowSize>
                <meltdownGlowSize>1.5</meltdownGlowSize>
                <pressurizedGlowInterval>30</pressurizedGlowInterval>
                <meltdownGlowInterval>15</meltdownGlowInterval>
            </li>
        </comps>
        <stages>
            <li>
                <label>nominal</label>
                <becomeVisible>false</becomeVisible>
            </li>
            <li>
                <minSeverity>0.25</minSeverity>
                <label>warm</label>
                <statOffsets>
                    <RangedWeapon_Cooldown>0.15</RangedWeapon_Cooldown>
                </statOffsets>
            </li>
            <li>
                <minSeverity>0.51</minSeverity>
                <label>overheated</label>
                <statOffsets>
                    <AimingDelayFactor>0.3</AimingDelayFactor>
                    <MoveSpeed>-0.5</MoveSpeed>
                    <RangedWeapon_Cooldown>0.3</RangedWeapon_Cooldown>
                </statOffsets>
                <painOffset>0.05</painOffset>
            </li>
            <li>
                <minSeverity>0.66</minSeverity>
                <label>pressurized</label>
                <statOffsets>
                    <ShootingAccuracyPawn>-0.2</ShootingAccuracyPawn>
                    <MoveSpeed>-1.5</MoveSpeed>
                    <AimingDelayFactor>0.5</AimingDelayFactor>
                </statOffsets>
                <painOffset>0.15</painOffset>
            </li>
            <li>
                <minSeverity>0.85</minSeverity>
                <label>meltdown imminent</label>
                <statOffsets>
                    <MoveSpeed>-3</MoveSpeed>
                    <ShootingAccuracyPawn>-0.4</ShootingAccuracyPawn>
                    <AimingDelayFactor>0.8</AimingDelayFactor>
                </statOffsets>
                <painOffset>0.3</painOffset>
            </li>
        </stages>
    </HediffDef>
</Defs>